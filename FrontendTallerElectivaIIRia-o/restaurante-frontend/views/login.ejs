<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Restaurante</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🍽️</h1>
            <p>Sistema de Restaurante</p>
        </div>

        <div class="form-container">
            <h2 style="text-align: center; margin-bottom: 30px; color: #333;">Iniciar Sesión</h2>
            
            <div id="loginAlert" class="alert hidden"></div>

            <form id="loginForm">
                <div class="form-group">
                    <label for="loginEmail">Email</label>
                    <input type="email" id="loginEmail" name="email" required>
                </div>

                <div class="form-group">
                    <label for="loginPassword">Contraseña</label>
                    <input type="password" id="loginPassword" name="password" required>
                </div>

                <button type="submit" class="btn btn-primary">
                    <span class="btn-text">Iniciar Sesión</span>
                    <div class="spinner hidden"></div>
                </button>
            </form>

            <div class="toggle-form">
                <p>¿No tienes cuenta? <a href="/register" id="registerLink">Regístrate aquí</a></p>
            </div>
        </div>
    </div>

    <script src="/js/dist/app.js"></script>
</body>
</html>