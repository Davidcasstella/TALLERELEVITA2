{
  "name": "restaurante-frontend",
  "version": "1.0.0",
  "description": "Frontend para sistema de restaurante con TypeScript",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:frontend": "tsc -p tsconfig.frontend.json",
    "watch:frontend": "tsc -p tsconfig.frontend.json --watch",
    "dev:fullstack": "concurrently \"npm run watch:frontend\" \"npm run dev\"",
    "type-check": "tsc --noEmit -p tsconfig.frontend.json",
    "lint": "eslint src/frontend --ext .ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "restaurant",
    "frontend",
    "express",
    "ejs",
    "typescript"
  ],
  "author": "Tu nombre",
  "license": "ISC"
}
